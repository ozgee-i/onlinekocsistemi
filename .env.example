# Kopyalayın: cp .env.example .env.local — .env.local asla commit edilmez.
# NEXT_PUBLIC_ önekli değişkenler tarayıcıya gider; gizli bilgi koymayın.

# --- Genel ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Supabase (Faz 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Yalnızca sunucu — src/lib/supabase/admin.ts dışında kullanılmaz
SUPABASE_SECRET_KEY=

# --- Ödeme (Faz 11) --- manual | lemonsqueezy
BILLING_PROVIDER=manual
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Diğer servisler (ilgili fazlarda) ---
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ANTHROPIC_API_KEY=
CRON_SECRET=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
